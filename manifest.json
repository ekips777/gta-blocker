{
  "manifest_version": 3,
  "name": "GTA 内容屏蔽助手",
  "version": "1.8.1",
  "description": "屏蔽中文互联网上的 GTA / 侠盗猎车手相关内容（B站、微博、知乎、百度、贴吧、抖音网页版、小红书、头条等），支持自定义关键词与选择器。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "GTA 内容屏蔽助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options.html"
}
